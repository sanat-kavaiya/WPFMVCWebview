<Window x:Class="WpfLoginApp.Views.SignupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfLoginApp.Views"
        mc:Ignorable="d"
        Title="Create Account" 
        Height="550" 
        Width="800"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True"
        WindowState="Normal"
        ResizeMode="NoResize">

    <Window.Resources>
        <!-- Accent color -->
        <Color x:Key="AccentColor">#0078D4</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="AccentHoverBrush" Color="#005A9E"/>

        <!-- Input field styles -->
        <Style x:Key="InputLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PasswordBoxStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.WindowTextBrushKey}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary button style (Signup) -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Secondary button style (Back to Login) -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Card style for signup container -->
        <Style x:Key="SignupCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.WindowBrushKey}}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="32"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.12"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- App title style -->
        <Style x:Key="AppTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <!-- Subtitle style -->
        <Style x:Key="SubtitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>

        <!-- Password requirements style -->
        <Style x:Key="RequirementStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            <Setter Property="Margin" Value="16,4,0,0"/>
        </Style>

    </Window.Resources>

    <!-- Background overlay -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
                <GradientStop Color="#005A9E" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <!-- Center the signup card -->
        <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Signup card -->
            <Border Style="{StaticResource SignupCardStyle}"
                    Width="450">
                <StackPanel>

                    <!-- App Logo/Title -->
                    <TextBlock Text="Create Account"
                               Style="{StaticResource AppTitleStyle}"/>

                    <TextBlock Text="Join us today! Fill in your details to get started."
                               Style="{StaticResource SubtitleStyle}"/>

                    <!-- Username field -->
                    <TextBlock Text="Username"
                               Style="{StaticResource InputLabelStyle}"/>
                    <TextBox Name="txtUsername"
                             Style="{StaticResource TextBoxStyle}"
                             Margin="0,0,0,16"/>

                    <!-- Password field -->
                    <TextBlock Text="Password"
                               Style="{StaticResource InputLabelStyle}"/>
                    <PasswordBox Name="txtPassword"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 Margin="0,0,0,8"/>

                    <!-- Password requirements hint -->
                    <!--<TextBlock Text="• Minimum 8 characters"
                               Style="{StaticResource RequirementStyle}"/>
                    <TextBlock Text="• At least 1 uppercase letter"
                               Style="{StaticResource RequirementStyle}"/>
                    <TextBlock Text="• At least 1 number"
                               Style="{StaticResource RequirementStyle}"
                               Margin="16,4,0,16"/>

                    --><!-- Confirm Password field --><!--
                    <TextBlock Text="Confirm Password"
                               Style="{StaticResource InputLabelStyle}"/>
                    <PasswordBox Name="txtConfirmPassword"
                                 Style="{StaticResource PasswordBoxStyle}"
                                 Margin="0,0,0,24"/>

                    --><!-- Terms and conditions checkbox --><!--
                    <CheckBox Name="chkTerms" 
                              Margin="0,0,0,20">
                        <TextBlock TextWrapping="Wrap">
                            I agree to the 
                            <Run Text="Terms of Service" 
                                 Foreground="{StaticResource AccentBrush}"
                                 TextDecorations="Underline"/>
                            and 
                            <Run Text="Privacy Policy"
                                 Foreground="{StaticResource AccentBrush}"
                                 TextDecorations="Underline"/>
                        </TextBlock>
                    </CheckBox>-->

                    <!-- Signup button -->
                    <Button Content="Sign Up"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="Signup_Click"
                            Margin="0,0,0,12"/>

                    <!-- Back to Login button -->
                    <Button Content="Already have an account? Sign In"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BackToLogin_Click"
                            Margin="0,0,0,0"/>

                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>